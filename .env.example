# ===== Spring =====
SPRING_PROFILES_ACTIVE=local

# ===== Database (MySQL 8.4) =====
DB_NAME=keepit
DB_USERNAME=keepit
DB_PASSWORD=keepit
DB_ROOT_PASSWORD=root
# [AWS 보류] prod 전용 (RDS)
# DB_URL=jdbc:mysql://<rds-endpoint>:3306/keepit?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# ===== JWT ===== (openssl rand -base64 64 로 생성)
JWT_SECRET=

# ===== Kakao Login =====
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# ===== [AWS 보류] AWS ===== (EC2에서는 IAM Role 사용 권장 - 키 불필요)
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ===== Docker image (prod compose) =====
DOCKER_IMAGE=<dockerhub-username>/keepit-be:latest
