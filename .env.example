# ===== Spring =====
SPRING_PROFILES_ACTIVE=local

# ===== Database (MySQL 8.4) =====
DB_NAME=keepit
DB_USERNAME=keepit
DB_PASSWORD=keepit
DB_ROOT_PASSWORD=root
# 개발 EC2의 RDS 연결에는 Terraform의 jdbc_url 출력을 사용합니다.
# DB_URL=jdbc:mysql://<rds-endpoint>:3306/keepit?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# ===== JWT ===== (openssl rand -base64 64 로 생성)
JWT_SECRET=

# ===== Kakao Login =====
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://43.203.239.171:8080/api/v1/auth/kakao/callback

# ===== 개발 EC2의 S3 설정 (EC2 IAM 역할로 인증) =====
# AWS_REGION=ap-northeast-2
# AWS_S3_BUCKET=<Terraform s3_bucket_name 출력>

# 배포 이미지 주소는 GitHub Actions가 EC2의 .image.env에 기록합니다.
