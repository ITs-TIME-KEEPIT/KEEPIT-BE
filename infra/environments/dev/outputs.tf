output "deployment_account" {
  value = data.aws_caller_identity.current.account_id
}

output "deployment_region" {
  value = var.aws_region
}

output "ec2_instance_id" {
  value = aws_instance.app.id
}

output "ec2_public_ip" {
  description = "Auto-assigned public IPv4 changes after stop/start. No Elastic IP is created."
  value       = aws_instance.app.public_ip
}

output "ssm_session_command" {
  value = "aws ssm start-session --target ${aws_instance.app.id} --region ${var.aws_region} --profile keepit-dev"
}

output "rds_endpoint" {
  value = aws_db_instance.main.endpoint
}

output "jdbc_url" {
  description = "Development TLS URL. Add the RDS CA to the JVM trust store and use VERIFY_IDENTITY before production."
  value       = "jdbc:mysql://${aws_db_instance.main.endpoint}/keepit?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
}

output "rds_admin_secret_arn" {
  description = "Secret ARN only; the password is generated by RDS and is not read into Terraform state."
  value       = aws_db_instance.main.master_user_secret[0].secret_arn
}

output "s3_bucket_name" {
  value = aws_s3_bucket.files.id
}

output "ecr_repository_url" {
  value = aws_ecr_repository.app.repository_url
}

output "github_deploy_role_arn" {
  value = aws_iam_role.github_deploy.arn
}
