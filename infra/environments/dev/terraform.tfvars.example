# Copy to terraform.tfvars only when preparing an approved deployment.
aws_region           = "ap-northeast-2"
aws_account_id       = "781953768324"
instance_type        = "t3.micro"
mysql_engine_version = "8.4"

# Development HTTP. Set [] to disable public web ingress, or restrict to your IPv4/32.
web_ingress_cidrs = ["0.0.0.0/0"]
