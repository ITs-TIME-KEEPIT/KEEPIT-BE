#!/bin/sh
# 커밋 메시지 형식 검사: {type}: {작업 내용}
msg=$(head -n 1 "$1")

case "$msg" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! echo "$msg" | grep -Eq '^(feat|fix|refactor|test|docs|chore|style|build|ci): .+[^.]$'; then
  echo "커밋 메시지 형식이 올바르지 않습니다: $msg"
  echo "형식: {type}: {작업 내용}  (예: feat: 카카오 로그인 API 구현)"
  echo "type: feat, fix, refactor, test, docs, chore, style, build, ci / 끝에 마침표 금지"
  exit 1
fi
